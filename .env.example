# ErmeMASHED – instellingen
# Kopieer dit bestand naar .env en vervang de waarden tussen < > door je eigen gegevens:
#   cp .env.example .env
# .env staat in .gitignore en komt dus nooit op GitHub. Zet je token alleen daar in.

# Welke Cloudflare-tunnel start er mee?
#   named = vaste link https://ermemashed.terpstack.dev (standaard)
#   quick = tijdelijke link op trycloudflare.com, als je even zonder token wilt testen
COMPOSE_PROFILES=named

# Token van de tunnel: Cloudflare Zero Trust > Networks > Tunnels > jouw tunnel,
# de lange tekst na --token (begint meestal met eyJ...)
CLOUDFLARE_TUNNEL_TOKEN=<plak-hier-je-cloudflare-tunnel-token>

# Publiek adres van de game. De public hostname van de tunnel in Cloudflare
# moet hetzelfde zijn: ermemashed.terpstack.dev -> http://frontend:80
PUBLIC_URL=https://ermemashed.terpstack.dev

# Poort om de game ook lokaal te spelen: http://localhost:8080
HTTP_PORT=8080
